# =============================================================================
# ExodoFlow Pro — variáveis de ambiente (EXEMPLO)
# Copie para .env.local (dev) ou configure no painel do Vercel (produção).
# NUNCA cometer .env.local nem chaves reais.
# =============================================================================

# ── Supabase (OBRIGATÓRIO) ───────────────────────────────────────────────────
# Painel Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua-anon-key
# service_role: SÓ servidor. NUNCA com prefixo NEXT_PUBLIC_. NUNCA expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua-service-role-key

# ── App (OBRIGATÓRIO) ────────────────────────────────────────────────────────
# URL pública da app — usada nos links do portal/assistente. Sem barra final.
NEXT_PUBLIC_APP_URL=https://app.seudominio.com
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Modos SIMULADO (manter a true até ligar os serviços reais) ───────────────
# Com 'true' o sistema funciona sem provedores externos (registo em logs).
WHATSAPP_OUTBOUND_MOCK=true
WHATSAPP_TEMPLATE_MOCK=true
RELATORIO_MOCK=true
ASSISTANT_MOCK=true

# ── WhatsApp Cloud API (Meta) — só quando ligar o WhatsApp real ──────────────
# Defina e ponha os *_MOCK acima a 'false' para enviar de verdade.
WHATSAPP_VERIFY_TOKEN=um-token-aleatorio-para-o-webhook
WHATSAPP_APP_SECRET=app-secret-da-meta
# Em PRODUÇÃO deixe isto OFF (não definir) — só dev sem assinatura.
# WHATSAPP_WEBHOOK_ALLOW_UNSIGNED_DEV=true

# ── Assistente de IA (Claude) — opcional, ativa respostas mais naturais ──────
# Defina a chave e ponha ASSISTANT_MOCK=false para usar a IA real.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Cron (lembretes automáticos) ─────────────────────────────────────────────
# Segredo que protege /api/cron/lembretes. O Vercel Cron envia-o automaticamente
# como 'Authorization: Bearer <CRON_SECRET>'. Gere um valor aleatório forte.
# Sem isto definido, a rota de cron responde 503 (desligada).
CRON_SECRET=um-segredo-aleatorio-forte-para-o-cron

# ── Observabilidade (opcional, recomendado em produção) ──────────────────────
# Sentry DSN — monitorização de erros. Sem isto, o sistema funciona na mesma.
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
